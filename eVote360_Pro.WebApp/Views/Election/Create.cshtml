@using eVote360_Pro.Application.DTOs.Election.Requests
@model CreateElectionRequest

<div class="max-w-2xl mx-auto">
    <div class="mb-8">
        <h1 class="text-3xl font-black text-gray-900 tracking-tight">Programar Elección</h1>
        <p class="text-gray-500 text-sm mt-1 font-medium">Registra un nuevo proceso electoral en el sistema. Inicialmente estará en estado Pendiente.</p>
    </div>

    <form asp-action="Create" method="post" class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8 space-y-6">
        
        <!-- Nombre de la elección -->
        <div>
            <label asp-for="Name" class="block text-xs font-black text-gray-400 uppercase tracking-wider mb-2">Nombre de la Elección</label>
            <input asp-for="Name" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:bg-white transition-all text-sm font-medium text-gray-900" placeholder="Ej: Elecciones Presidenciales 2028" required />
            <span asp-validation-for="Name" class="text-red-500 text-xs font-bold mt-1 block"></span>
        </div>

        <!-- Fecha de Realización -->
        <div>
            <label asp-for="RealizationDate" class="block text-xs font-black text-gray-400 uppercase tracking-wider mb-2">Fecha de Realización</label>
            <input asp-for="RealizationDate" type="date" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:bg-white transition-all text-sm font-medium text-gray-900" required />
            <span asp-validation-for="RealizationDate" class="text-red-500 text-xs font-bold mt-1 block"></span>
        </div>

        <!-- Botones de Acción -->
        <div class="pt-6 border-t border-gray-100 flex items-center justify-end gap-3">
            <a asp-action="Index" class="px-5 py-2.5 text-sm font-bold text-gray-600 hover:bg-gray-100 rounded-xl transition-colors cursor-pointer">
                Cancelar
            </a>
            <button type="submit" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-xl font-bold transition-all shadow-lg shadow-blue-200 hover:shadow-blue-300 hover:-translate-y-0.5 active:scale-95 active:translate-y-0 cursor-pointer">
                <i data-lucide="save" class="w-4 h-4"></i>
                Guardar Elección
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
