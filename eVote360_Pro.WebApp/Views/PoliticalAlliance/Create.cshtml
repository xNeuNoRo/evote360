@using eVote360_Pro.Application.DTOs.PoliticalParty.Responses
@model IEnumerable<PoliticalPartyResponse>

<div class="max-w-2xl mx-auto">
    <div class="mb-8">
        <h1 class="text-3xl font-black text-gray-900 tracking-tight">Nueva Alianza Política</h1>
        <p class="text-gray-500 text-sm mt-1 font-medium">Envía una solicitud de alianza a otro partido político.</p>
    </div>

    <div style="view-transition-name: card-alliance;" class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8">
        @if (!Model.Any())
        {
            <div class="p-6 bg-blue-50/50 border border-blue-100 rounded-2xl flex gap-4 text-center items-center justify-center flex-col">
                <i data-lucide="info" class="w-8 h-8 text-blue-500 mb-2"></i>
                <p class="text-sm font-bold text-blue-800">
                    No hay partidos políticos disponibles para realizar una alianza en este momento.
                </p>
                <p class="text-xs text-blue-600 mt-1">
                    Esto puede deberse a que ya tienes alianzas o solicitudes pendientes con todos los partidos activos.
                </p>
                <a asp-action="Index" class="mt-4 px-5 py-2.5 text-sm font-bold bg-white text-blue-700 hover:bg-blue-100 rounded-xl transition-colors cursor-pointer border border-blue-200">
                    Volver a Alianzas
                </a>
            </div>
        }
        else
        {
            <form asp-action="Create" method="post" class="space-y-6">
                <div>
                    <label for="receiverPartyId" class="block text-xs font-black text-gray-400 uppercase tracking-wider mb-2">Partido Político Destino</label>
                    <div class="relative">
                        <select id="receiverPartyId" name="receiverPartyId" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:bg-white transition-all text-sm font-medium text-gray-900 appearance-none cursor-pointer">
                            <option value="">-- Selecciona un Partido Político --</option>
                            @foreach (var party in Model)
                            {
                                <option value="@party.Id">@party.Name (@party.Acronym)</option>
                            }
                        </select>
                        <i data-lucide="chevron-down" class="w-4 h-4 text-gray-400 absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                    </div>
                    <p class="text-xs font-medium text-gray-500 mt-2">Solo se muestran partidos activos con los que no tienes una alianza vigente ni solicitudes en espera.</p>
                </div>

                <div class="pt-6 border-t border-gray-100 flex items-center justify-end gap-3">
                    <a asp-action="Index" class="px-5 py-2.5 text-sm font-bold text-gray-600 hover:bg-gray-100 rounded-xl transition-colors cursor-pointer">
                        Cancelar
                    </a>
                    <button type="submit" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-xl font-bold transition-all shadow-lg shadow-blue-200 hover:shadow-blue-300 hover:-translate-y-0.5 active:scale-95 active:translate-y-0 cursor-pointer">
                        <i data-lucide="send" class="w-4 h-4"></i>
                        Enviar Solicitud
                    </button>
                </div>
            </form>
        }
    </div>
</div>
