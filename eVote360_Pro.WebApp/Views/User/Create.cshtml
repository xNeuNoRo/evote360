@model eVote360_Pro.Application.ViewModels.UserViewModels.CreateUserViewModel
@{
    ViewData["Title"] = "Crear Usuario";
    ViewData["Breadcrumbs"] = new List<(string, string?, string?)>
    {
        ("Seguridad", null, null),
        ("Usuarios", "Index", "User"),
        ("Crear", null, null)
    };
}

<div class="max-w-3xl mx-auto">
    <div class="mb-8 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-black text-gray-900 tracking-tight flex items-center gap-2">
                <i data-lucide="user-plus" class="w-6 h-6 text-blue-600"></i>
                Crear Usuario
            </h1>
            <p class="text-sm text-gray-500 mt-1 font-medium">Registra un nuevo administrador o dirigente político en el sistema.</p>
        </div>
    </div>

    <div style="view-transition-name: card-user;" class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
        <form asp-action="Create" method="post" class="space-y-6">
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label asp-for="FirstName" class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-2">Nombres <span class="text-red-500">*</span></label>
                    <input asp-for="FirstName" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all text-sm font-bold text-gray-900" />
                    <span asp-validation-for="FirstName" class="text-xs font-bold text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="LastName" class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-2">Apellidos <span class="text-red-500">*</span></label>
                    <input asp-for="LastName" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all text-sm font-bold text-gray-900" />
                    <span asp-validation-for="LastName" class="text-xs font-bold text-red-500 mt-1 block"></span>
                </div>

                <div class="md:col-span-2">
                    <label asp-for="Email" class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-2">Correo Electrónico <span class="text-red-500">*</span></label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i data-lucide="mail" class="w-5 h-5 text-gray-400"></i>
                        </div>
                        <input asp-for="Email" type="email" placeholder="usuario@ejemplo.com" class="w-full pl-11 pr-4 py-3 rounded-xl border border-gray-200 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all text-sm font-medium text-gray-900" />
                    </div>
                    <span asp-validation-for="Email" class="text-xs font-bold text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Username" class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-2">Nombre de Usuario <span class="text-red-500">*</span></label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i data-lucide="at-sign" class="w-5 h-5 text-gray-400"></i>
                        </div>
                        <input asp-for="Username" class="w-full pl-11 pr-4 py-3 rounded-xl border border-gray-200 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all text-sm font-bold text-gray-900" />
                    </div>
                    <span asp-validation-for="Username" class="text-xs font-bold text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Password" class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-2">Contraseña <span class="text-red-500">*</span></label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i data-lucide="key" class="w-5 h-5 text-gray-400"></i>
                        </div>
                        <input asp-for="Password" type="password" class="w-full pl-11 pr-4 py-3 rounded-xl border border-gray-200 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all text-sm font-bold text-gray-900" />
                    </div>
                    <span asp-validation-for="Password" class="text-xs font-bold text-red-500 mt-1 block"></span>
                    <p class="text-[10px] text-gray-400 mt-1 uppercase font-bold tracking-wider">Mínimo 8 caracteres (Letras y Números).</p>
                </div>

                <div class="md:col-span-2">
                    <label asp-for="RoleId" class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-2">Rol de Usuario <span class="text-red-500">*</span></label>
                    <select asp-for="RoleId" asp-items="ViewBag.Roles" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all text-sm font-bold text-gray-900 bg-white">
                        <option value="">Seleccione un Rol...</option>
                    </select>
                    <span asp-validation-for="RoleId" class="text-xs font-bold text-red-500 mt-1 block"></span>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-6 border-t border-gray-100">
                <a asp-action="Index" class="px-5 py-2.5 text-sm font-bold text-gray-600 bg-gray-100 rounded-xl hover:bg-gray-200 transition-colors cursor-pointer">
                    Cancelar
                </a>
                <button type="submit" class="px-6 py-2.5 text-sm font-bold text-white bg-blue-600 rounded-xl hover:bg-blue-700 shadow-lg shadow-blue-200 transition-all cursor-pointer transform hover:-translate-y-0.5 active:scale-95 flex items-center gap-2">
                    <i data-lucide="save" class="w-4 h-4"></i>
                    Crear Usuario
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
