@{
    ViewData["Title"] = "Asignar Partido";
    ViewData["Breadcrumbs"] = new List<(string, string?, string?)>
    {
        ("Seguridad", "Index", "Dashboard"),
        ("Usuarios", "Index", "User"),
        ("Asignar Partido", null, null)
    };
    var currentPartyId = ViewBag.CurrentPartyId as int?;
}

<div class="max-w-2xl mx-auto">
    <div class="mb-8 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-black text-gray-900 tracking-tight flex items-center gap-2">
                <i data-lucide="link" class="w-6 h-6 text-blue-600"></i>
                Asignar Partido a Dirigente
            </h1>
            <p class="text-sm text-gray-500 mt-1 font-medium">Vincula a este usuario con un partido político para que pueda gestionarlo.</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
        
        <div class="flex items-center gap-4 p-4 rounded-xl bg-blue-50/50 border border-blue-100 mb-8">
            <div class="w-12 h-12 rounded-full bg-white border border-blue-200 flex items-center justify-center text-blue-700 font-black shrink-0 shadow-sm">
                <i data-lucide="user" class="w-6 h-6"></i>
            </div>
            <div>
                <p class="text-xs font-black text-blue-500 uppercase tracking-wider">Dirigente Político</p>
                <h3 class="text-lg font-black text-gray-900">@ViewBag.UserFullName</h3>
            </div>
        </div>

        @if (currentPartyId.HasValue)
        {
            <div class="mb-8 p-4 rounded-xl border border-red-100 bg-red-50/50">
                <div class="flex items-start gap-3">
                    <i data-lucide="alert-triangle" class="w-5 h-5 text-red-600 mt-0.5 shrink-0"></i>
                    <div>
                        <h4 class="text-sm font-bold text-red-900">Este dirigente ya tiene un partido asignado</h4>
                        <p class="text-xs text-red-700 mt-1">Si deseas asignarle uno diferente o dejarlo sin partido, primero debes remover la asignación actual.</p>
                        
                        <form asp-action="RemoveParty" method="post" class="mt-4">
                            <input type="hidden" name="userId" value="@ViewBag.UserId" />
                            <button type="submit" class="inline-flex items-center justify-center gap-2 px-4 py-2 text-xs font-bold text-red-700 bg-red-100 rounded-lg hover:bg-red-200 transition-colors">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                                Remover Asignación Actual
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
        else
        {
            <form asp-action="AssignPartyPost" method="post" class="space-y-6">
                <input type="hidden" name="userId" value="@ViewBag.UserId" />
                
                <div>
                    <label for="partyId" class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-2">Seleccione el Partido Político <span class="text-red-500">*</span></label>
                    <select id="partyId" name="partyId" asp-items="ViewBag.Parties" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all text-sm font-bold text-gray-900 bg-white">
                        <option value="">Seleccione un partido...</option>
                    </select>
                </div>

                <div class="flex items-center justify-end gap-3 pt-6 border-t border-gray-100">
                    <a asp-action="Index" class="px-5 py-2.5 text-sm font-bold text-gray-600 bg-gray-100 rounded-xl hover:bg-gray-200 transition-colors cursor-pointer">
                        Cancelar
                    </a>
                    <button type="submit" class="px-6 py-2.5 text-sm font-bold text-white bg-blue-600 rounded-xl hover:bg-blue-700 shadow-lg shadow-blue-200 transition-all cursor-pointer transform hover:-translate-y-0.5 active:scale-95 flex items-center gap-2">
                        <i data-lucide="link" class="w-4 h-4"></i>
                        Vincular Partido
                    </button>
                </div>
            </form>
        }
    </div>
</div>
