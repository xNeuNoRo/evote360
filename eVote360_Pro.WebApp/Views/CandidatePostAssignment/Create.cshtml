@using eVote360_Pro.Application.DTOs.Candidate.Responses
@using eVote360_Pro.Application.DTOs.ElectivePosition.Responses
@{
    var candidates = ViewBag.Candidates as IEnumerable<CandidateResponse> ?? new List<CandidateResponse>();
    var positions = ViewBag.Positions as IEnumerable<ElectivePositionResponse> ?? new List<ElectivePositionResponse>();
    var myPartyId = (int)ViewBag.MyPartyId;
}

<div class="max-w-2xl mx-auto">
    <div class="mb-8 flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-black text-gray-900 tracking-tight">Asignar Candidato</h1>
            <p class="text-gray-500 text-sm mt-1 font-medium">Asigna un candidato propio o aliado a un puesto electivo para tu partido.</p>
        </div>
    </div>

    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8">
        @if (!candidates.Any())
        {
            <div class="p-6 bg-amber-50/50 border border-amber-100 rounded-2xl flex gap-4 text-center items-center justify-center flex-col mb-4">
                <i data-lucide="users" class="w-8 h-8 text-amber-500 mb-2"></i>
                <p class="text-sm font-bold text-amber-800">
                    No hay candidatos disponibles para asignar.
                </p>
                <p class="text-xs text-amber-600 mt-1">
                    Todos los candidatos (propios y aliados) ya están asignados a puestos o no existen candidatos activos.
                </p>
                <a asp-action="Index" class="mt-4 px-5 py-2.5 text-sm font-bold bg-white text-amber-700 hover:bg-amber-100 rounded-xl transition-colors cursor-pointer border border-amber-200">
                    Volver
                </a>
            </div>
        }
        else if (!positions.Any())
        {
            <div class="p-6 bg-red-50/50 border border-red-100 rounded-2xl flex gap-4 text-center items-center justify-center flex-col mb-4">
                <i data-lucide="award" class="w-8 h-8 text-red-500 mb-2"></i>
                <p class="text-sm font-bold text-red-800">
                    No hay puestos electivos activos en el sistema.
                </p>
                <a asp-action="Index" class="mt-4 px-5 py-2.5 text-sm font-bold bg-white text-red-700 hover:bg-red-100 rounded-xl transition-colors cursor-pointer border border-red-200">
                    Volver
                </a>
            </div>
        }
        else
        {
            <form asp-action="Create" method="post" class="space-y-6">
                <!-- We'll calculate isAlly dynamically via JS and submit it in a hidden field, though the backend also checks it. -->
                <input type="hidden" id="isAlly" name="isAlly" value="false" />
                <input type="hidden" id="myPartyId" value="@myPartyId" />

                <div>
                    <label for="candidateId" class="block text-xs font-black text-gray-400 uppercase tracking-wider mb-2">Seleccionar Candidato</label>
                    <div class="relative">
                        <select id="candidateId" name="candidateId" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:bg-white transition-all text-sm font-medium text-gray-900 appearance-none cursor-pointer">
                            <option value="" data-party="">-- Elige un Candidato --</option>
                            <optgroup label="Candidatos Propios">
                                @foreach (var c in candidates.Where(c => c.OriginalPartyId == myPartyId))
                                {
                                    <option value="@c.Id" data-party="@c.OriginalPartyId">@c.FullName (Propio)</option>
                                }
                            </optgroup>
                            <optgroup label="Candidatos Aliados">
                                @foreach (var c in candidates.Where(c => c.OriginalPartyId != myPartyId))
                                {
                                    <option value="@c.Id" data-party="@c.OriginalPartyId">@c.FullName (@c.OriginalPartyAcronym)</option>
                                }
                            </optgroup>
                        </select>
                        <i data-lucide="chevron-down" class="w-4 h-4 text-gray-400 absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                    </div>
                </div>

                <div>
                    <label for="positionId" class="block text-xs font-black text-gray-400 uppercase tracking-wider mb-2">Asignar a Puesto Electivo</label>
                    <div class="relative">
                        <select id="positionId" name="positionId" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:bg-white transition-all text-sm font-medium text-gray-900 appearance-none cursor-pointer">
                            <option value="">-- Elige un Puesto --</option>
                            @foreach (var p in positions)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                        <i data-lucide="chevron-down" class="w-4 h-4 text-gray-400 absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                    </div>
                    <p class="text-xs text-gray-500 mt-2 font-medium bg-blue-50 p-2 rounded-lg text-blue-800 border border-blue-100">
                        <i data-lucide="info" class="w-3 h-3 inline mr-1"></i>
                        Si seleccionas un candidato aliado, recuerda que solo puedes asignarlo al mismo puesto al que aspira en su partido de origen.
                    </p>
                </div>

                <div class="pt-6 border-t border-gray-100 flex items-center justify-end gap-3">
                    <a asp-action="Index" class="px-5 py-2.5 text-sm font-bold text-gray-600 hover:bg-gray-100 rounded-xl transition-colors cursor-pointer">
                        Cancelar
                    </a>
                    <button type="submit" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-xl font-bold transition-all shadow-lg shadow-blue-200 hover:shadow-blue-300 hover:-translate-y-0.5 active:scale-95 active:translate-y-0 cursor-pointer">
                        <i data-lucide="save" class="w-4 h-4"></i>
                        Asignar Candidato
                    </button>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        const candidateSelect = document.getElementById('candidateId');
        const isAllyInput = document.getElementById('isAlly');
        const myPartyId = document.getElementById('myPartyId').value;

        if (candidateSelect) {
            candidateSelect.addEventListener('change', function() {
                const selectedOption = this.options[this.selectedIndex];
                const originalPartyId = selectedOption.getAttribute('data-party');
                
                if (originalPartyId && originalPartyId !== myPartyId) {
                    isAllyInput.value = 'true';
                } else {
                    isAllyInput.value = 'false';
                }
            });
        }
    </script>
}
