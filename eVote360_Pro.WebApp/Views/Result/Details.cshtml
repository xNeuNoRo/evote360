@using eVote360_Pro.Application.DTOs.Voting.Responses
@model ResultReportResponse
@{
    var ballotJson = System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });
}

<div style="view-transition-name: card-result-@Model.ElectionId;" class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-gray-100 pb-6">
    <div>
        <h1 class="text-3xl font-black text-gray-900 tracking-tight">@Model.ElectionName</h1>
        <p class="text-gray-500 text-sm mt-1 font-medium">Resultados Oficiales del Escrutinio</p>
    </div>
    <div class="bg-blue-50 text-blue-700 px-5 py-3 rounded-2xl flex items-center gap-3">
        <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center text-blue-600 shadow-sm">
            <i data-lucide="users" class="w-5 h-5"></i>
        </div>
        <div>
            <p class="text-xs font-black uppercase tracking-wider opacity-70">Total Votantes</p>
            <p class="text-xl font-black leading-none">@Model.TotalVoters.ToString("N0")</p>
        </div>
    </div>
</div>

@if (!Model.ResultsByPosition.Any())
{
    <div class="py-20 text-center">
        <div class="w-20 h-20 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-4 text-gray-400">
            <i data-lucide="inbox" class="w-10 h-10"></i>
        </div>
        <h3 class="text-xl font-black text-gray-900">No hay datos disponibles</h3>
        <p class="text-gray-500 mt-2 font-medium">Aún no se han configurado puestos ni se han registrado votos para esta elección.</p>
    </div>
}
else
{
    <div class="flex flex-col lg:flex-row gap-8 items-start">
        <!-- Sidebar Nieles Electivos -->
        <div class="w-full lg:w-1/4 bg-white border border-gray-100 rounded-3xl p-4 shadow-sm sticky top-24">
            <h3 class="text-xs font-black text-gray-400 uppercase tracking-widest mb-4 px-2">Niveles Electivos</h3>
            <div class="space-y-1">
                @foreach (var pos in Model.ResultsByPosition)
                {
                    <button type="button" onclick="loadPositionData(@pos.PositionId)" id="btn-pos-@pos.PositionId"
                            class="w-full flex items-center justify-between px-4 py-3 rounded-xl font-bold text-sm transition-all text-left group
                                   @(pos == Model.ResultsByPosition.First() ? "bg-blue-50 text-blue-700" : "text-gray-600 hover:bg-gray-50")">
                        @pos.PositionName
                        <i data-lucide="chevron-right" class="w-4 h-4 opacity-50 group-hover:translate-x-1 transition-transform"></i>
                    </button>
                }
            </div>
        </div>

        <!-- Contenido de Resultados -->
        <div class="w-full lg:w-3/4 space-y-8" id="resultContent">
            <!-- JS Inyectará la gráfica y el ganador aquí -->
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const reportData = @Html.Raw(ballotJson);
        const positions = reportData.resultsByPosition;
        let resultChart = null;

        function loadPositionData(positionId) {
            // Actualizar UI del sidebar
            document.querySelectorAll('[id^="btn-pos-"]').forEach(btn => {
                btn.className = "w-full flex items-center justify-between px-4 py-3 rounded-xl font-bold text-sm transition-all text-left group text-gray-600 hover:bg-gray-50";
            });
            const activeBtn = document.getElementById(`btn-pos-${positionId}`);
            if(activeBtn) {
                activeBtn.className = "w-full flex items-center justify-between px-4 py-3 rounded-xl font-bold text-sm transition-all text-left group bg-blue-50 text-blue-700";
            }

            const pos = positions.find(p => p.positionId === positionId);
            if(!pos) return;

            const container = document.getElementById('resultContent');
            
            // Ordenar por votos
            const sortedCandidates = [...pos.candidates].sort((a,b) => b.votesCount - a.votesCount);
            const winner = sortedCandidates.length > 0 ? sortedCandidates[0] : null;

            let winnerHtml = '';
            if (pos.isTie) {
                winnerHtml = `
                    <div class="bg-amber-50 border border-amber-100 rounded-3xl p-6 flex items-start gap-4 animate__animated animate__fadeIn">
                        <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center shrink-0">
                            <i data-lucide="scale" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <h3 class="text-lg font-black text-amber-900">¡Empate Electoral!</h3>
                            <p class="text-sm font-medium text-amber-700 mt-1">
                                Existen múltiples candidatos con la misma cantidad máxima de votos (${winner.votesCount} votos). 
                                Se requiere un proceso de desempate según la ley electoral.
                            </p>
                        </div>
                    </div>
                `;
            } else if (winner && winner.votesCount > 0) {
                const isNone = winner.candidateId === null;
                const winnerName = isNone ? "Ninguno (Voto en blanco)" : winner.candidateName;

                winnerHtml = `
                    <div class="bg-gradient-to-tr from-emerald-600 to-teal-500 rounded-3xl p-8 text-white shadow-xl shadow-emerald-500/20 relative overflow-hidden animate__animated animate__fadeIn">
                        <div class="absolute inset-0 bg-[url('~/images/pattern.svg')] opacity-10"></div>
                        <div class="relative z-10 flex items-center justify-between">
                            <div class="flex items-center gap-5">
                                ${!isNone && winner.photoUrl ? `
                                    <img src="${winner.photoUrl}" class="w-20 h-20 rounded-full border-4 border-white/30 object-cover shadow-lg" onerror="this.src='/uploads/candidates/default.png'" />
                                ` : `
                                    <div class="w-20 h-20 bg-white/20 rounded-full border-4 border-white/30 flex items-center justify-center backdrop-blur-sm">
                                        <i data-lucide="trophy" class="w-8 h-8 text-white"></i>
                                    </div>
                                `}
                                <div>
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-black bg-white text-emerald-700 uppercase tracking-widest mb-2">
                                        ${isNone ? 'Voto Mayoritario' : 'Ganador Proyectado'}
                                    </span>
                                    <h3 class="text-2xl font-black tracking-tight leading-none">${winnerName}</h3>
                                    ${!isNone ? `<p class="text-emerald-100 font-bold mt-1">${winner.partyName}</p>` : ''}
                                </div>
                            </div>
                            <div class="text-right hidden sm:block">
                                <p class="text-[10px] font-black text-emerald-200 uppercase tracking-widest">Porcentaje</p>
                                <p class="text-4xl font-black">${winner.percentage.toFixed(1)}%</p>
                            </div>
                        </div>
                    </div>
                `;
            } else {
                winnerHtml = `
                    <div class="bg-gray-50 border border-gray-100 rounded-3xl p-6 text-center text-gray-500 animate__animated animate__fadeIn">
                        Aún no se han computado votos para este nivel electivo.
                    </div>
                `;
            }

            // Preparar Gráfica
            const labels = pos.candidates.map(c => c.candidateId === null ? "Voto en Blanco" : c.candidateName);
            const dataVotes = pos.candidates.map(c => c.votesCount);
            
            // Generar colores premium aleatorios o fijos
            const bgColors = [
                'rgba(59, 130, 246, 0.8)', // blue-500
                'rgba(16, 185, 129, 0.8)', // emerald-500
                'rgba(245, 158, 11, 0.8)', // amber-500
                'rgba(239, 68, 68, 0.8)', // red-500
                'rgba(139, 92, 246, 0.8)', // violet-500
                'rgba(107, 114, 128, 0.8)', // gray-500
            ];

            const borderColors = bgColors.map(c => c.replace('0.8', '1'));

            let mainContent = `
                ${winnerHtml}

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mt-8 animate__animated animate__fadeIn animate__delay-1s">
                    <!-- Bar Chart -->
                    <div class="bg-white border border-gray-100 rounded-3xl p-6 shadow-sm flex flex-col justify-center">
                        <h4 class="text-sm font-black text-gray-900 tracking-tight mb-6">Distribución de Votos (Absoluta)</h4>
                        <canvas id="barChart" height="250"></canvas>
                    </div>

                    <!-- Pie Chart -->
                    <div class="bg-white border border-gray-100 rounded-3xl p-6 shadow-sm flex flex-col justify-center items-center">
                        <h4 class="text-sm font-black text-gray-900 tracking-tight mb-6 w-full text-left">Proporción (%)</h4>
                        <div class="w-full max-w-[250px]">
                            <canvas id="pieChart" height="250"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Tabla de desglose -->
                <div class="bg-white border border-gray-100 rounded-3xl overflow-hidden shadow-sm mt-8 animate__animated animate__fadeIn animate__delay-1s">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-50/50 border-b border-gray-100">
                                <th class="py-4 px-6 text-xs font-black text-gray-400 uppercase tracking-wider">Candidato / Partido</th>
                                <th class="py-4 px-6 text-xs font-black text-gray-400 uppercase tracking-wider text-right">Votos</th>
                                <th class="py-4 px-6 text-xs font-black text-gray-400 uppercase tracking-wider text-right">%</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50">
                            ${sortedCandidates.map(c => {
                                const cName = c.candidateId === null ? "Ninguno (Voto en blanco)" : c.candidateName;
                                const pName = c.candidateId === null ? "-" : c.partyName;
                                return `
                                    <tr class="hover:bg-gray-50/50 transition-colors">
                                        <td class="py-4 px-6">
                                            <p class="text-sm font-black text-gray-900 tracking-tight">${cName}</p>
                                            <p class="text-xs font-medium text-gray-500">${pName}</p>
                                        </td>
                                        <td class="py-4 px-6 text-right">
                                            <span class="text-sm font-black text-gray-900">${c.votesCount.toLocaleString()}</span>
                                        </td>
                                        <td class="py-4 px-6 text-right">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-gray-100 text-gray-700">
                                                ${c.percentage.toFixed(2)}%
                                            </span>
                                        </td>
                                    </tr>
                                `;
                            }).join('')}
                        </tbody>
                    </table>
                </div>
            `;

            container.innerHTML = mainContent;
            lucide.createIcons();

            // Render Charts
            const barCtx = document.getElementById('barChart').getContext('2d');
            const pieCtx = document.getElementById('pieChart').getContext('2d');

            new Chart(barCtx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Votos',
                        data: dataVotes,
                        backgroundColor: bgColors,
                        borderColor: borderColors,
                        borderWidth: 1,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, grid: { borderDash: [4, 4] } },
                        x: { grid: { display: false } }
                    }
                }
            });

            new Chart(pieCtx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: dataVotes,
                        backgroundColor: bgColors,
                        borderColor: '#ffffff',
                        borderWidth: 2,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '65%',
                    plugins: {
                        legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8, font: { family: "'Inter', sans-serif", weight: 'bold' } } }
                    }
                }
            });
        }

        // Init with first position
        if (positions && positions.length > 0) {
            loadPositionData(positions[0].positionId);
        }
    </script>
}
