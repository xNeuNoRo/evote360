@{
    ViewData["Title"] = "Asignación de Dirigentes";
    ViewData["Breadcrumbs"] = new List<(string, string?, string?)>
    {
        ("Mantenimientos", null, null),
        ("Asignar Dirigente", null, null)
    };
}

<div class="max-w-4xl mx-auto">
    <div class="mb-8 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-black text-gray-900 tracking-tight flex items-center gap-2">
                <i data-lucide="link" class="w-6 h-6 text-blue-600"></i>
                Asignación de Dirigentes Políticos
            </h1>
            <p class="text-sm text-gray-500 mt-1 font-medium">Vincula a los dirigentes con sus respectivos partidos políticos para que puedan gestionarlos.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.SelectedUserFullName as string))
    {
        <div class="flex items-center gap-4 p-4 rounded-xl bg-blue-50/50 border border-blue-100 mb-8 max-w-4xl">
            <div class="w-12 h-12 rounded-full bg-white border border-blue-200 flex items-center justify-center text-blue-700 font-black shrink-0 shadow-sm">
                <i data-lucide="user" class="w-6 h-6"></i>
            </div>
            <div class="flex-1">
                <p class="text-xs font-black text-blue-500 uppercase tracking-wider">Dirigente Seleccionado</p>
                <h3 class="text-lg font-black text-gray-900">@ViewBag.SelectedUserFullName</h3>
            </div>
            @if (ViewBag.HasPartyAssigned == true)
            {
                <div class="px-3 py-1 bg-red-100 text-red-700 rounded-lg text-xs font-bold whitespace-nowrap">
                    Ya tiene partido asignado
                </div>
            }
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Panel de Asignación -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8 h-fit">
            <h2 class="text-lg font-black text-gray-900 mb-6 flex items-center gap-2">
                <i data-lucide="plus-circle" class="w-5 h-5 text-emerald-600"></i>
                Nueva Asignación
            </h2>

            <form asp-action="AssignLeader" method="post" class="space-y-6">
                <div>
                    <label for="userId" class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-2">Seleccione el Dirigente <span class="text-red-500">*</span></label>
                    <select id="userId" name="userId" asp-items="ViewBag.Users" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all text-sm font-bold text-gray-900 bg-white">
                        <option value="">Seleccione un dirigente...</option>
                    </select>
                </div>

                <div>
                    <label for="partyId" class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-2">Seleccione el Partido Político <span class="text-red-500">*</span></label>
                    <select id="partyId" name="partyId" asp-items="ViewBag.Parties" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all text-sm font-bold text-gray-900 bg-white">
                        <option value="">Seleccione un partido...</option>
                    </select>
                </div>

                <div class="pt-6 border-t border-gray-100">
                    <button type="submit" class="w-full justify-center px-6 py-3 text-sm font-bold text-white bg-blue-600 rounded-xl hover:bg-blue-700 shadow-lg shadow-blue-200 transition-all cursor-pointer transform hover:-translate-y-0.5 active:scale-95 flex items-center gap-2">
                        <i data-lucide="link" class="w-4 h-4"></i>
                        Asignar Dirigente
                    </button>
                </div>
            </form>
        </div>

        <!-- Panel de Remoción -->
        <div class="bg-white rounded-2xl shadow-sm border border-red-100 p-6 sm:p-8 h-fit">
            <h2 class="text-lg font-black text-red-900 mb-2 flex items-center gap-2">
                <i data-lucide="trash-2" class="w-5 h-5 text-red-600"></i>
                Remover Asignación
            </h2>
            <p class="text-xs text-red-600 mb-6 font-medium">Si deseas asignar un partido diferente a un dirigente, primero debes remover su asignación actual aquí.</p>

            <form asp-action="RemoveLeader" method="post" class="space-y-6">
                <div>
                    <label for="removeUserId" class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-2">Dirigentes con Partido Asignado</label>
                    <select id="removeUserId" name="userId" asp-items="ViewBag.AssignedLeaders" required class="w-full px-4 py-3 rounded-xl border border-red-200 focus:border-red-500 focus:ring-4 focus:ring-red-500/10 transition-all text-sm font-bold text-gray-900 bg-white">
                        <option value="">Seleccione un dirigente para remover...</option>
                    </select>
                </div>

                <div class="pt-6 border-t border-gray-100">
                    <button type="submit" class="w-full justify-center px-6 py-3 text-sm font-bold text-red-700 bg-red-50 rounded-xl hover:bg-red-100 border border-red-200 transition-all cursor-pointer transform hover:-translate-y-0.5 active:scale-95 flex items-center gap-2">
                        <i data-lucide="unlink" class="w-4 h-4"></i>
                        Remover Asignación
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
