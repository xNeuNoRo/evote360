@model eVote360_Pro.Application.Interfaces.Services.LeaderDashboardStatisticsResponse
@{
    ViewData["Title"] = "Panel de Dirigente";
    ViewData["Breadcrumbs"] = new List<(string, string?, string?)>
    {
        ("Inicio", null, null),
        ("Mi Partido", null, null)
    };
}

<div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
        <h1 class="text-3xl font-black text-gray-900 tracking-tight flex items-center gap-2">
            <i data-lucide="bar-chart-2" class="w-8 h-8 text-blue-600"></i>
            Estado de mi Partido
        </h1>
        <p class="text-sm text-gray-500 mt-2 font-medium">Indicadores clave de tus candidatos y alianzas políticas.</p>
    </div>
    <div class="flex gap-2">
        <a asp-controller="Candidate" asp-action="Create" style="view-transition-name: btn-new-candidate;" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-white border border-gray-200 text-gray-700 text-sm font-bold rounded-xl hover:bg-gray-50 transition-all cursor-pointer transform hover:-translate-y-0.5 active:scale-95 shadow-sm">
            <i data-lucide="user-plus" class="w-4 h-4 text-blue-600"></i>
            Nuevo Candidato
        </a>
        <a asp-controller="PoliticalAlliance" asp-action="Create" style="view-transition-name: btn-new-alliance;" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-bold rounded-xl hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-200 transition-all cursor-pointer transform hover:-translate-y-0.5 active:scale-95">
            <i data-lucide="handshake" class="w-4 h-4"></i>
            Proponer Alianza
        </a>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Active Candidates -->
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-start justify-between hover-scale group cursor-default">
        <div>
            <h3 class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">Candidatos Activos</h3>
            <div class="flex items-baseline gap-2">
                <p class="text-4xl font-black text-gray-900">@Model.ActiveCandidates</p>
                <span class="text-xs font-bold text-emerald-500 bg-emerald-50 px-2 py-0.5 rounded-md">Vigentes</span>
            </div>
            <p class="text-xs text-gray-400 mt-2 font-medium">@Model.InactiveCandidates candidatos inactivos</p>
        </div>
        <div class="p-4 bg-blue-50 text-blue-600 rounded-2xl group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300">
            <i data-lucide="users" class="w-7 h-7"></i>
        </div>
    </div>

    <!-- Approved Alliances -->
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-start justify-between hover-scale group cursor-default">
        <div>
            <h3 class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">Alianzas Activas</h3>
            <div class="flex items-baseline gap-2">
                <p class="text-4xl font-black text-gray-900">@Model.ApprovedAlliances</p>
            </div>
            <p class="text-xs text-gray-400 mt-2 font-medium">Partidos aliados aprobados</p>
        </div>
        <div class="p-4 bg-indigo-50 text-indigo-600 rounded-2xl group-hover:bg-indigo-600 group-hover:text-white transition-colors duration-300">
            <i data-lucide="shield-check" class="w-7 h-7"></i>
        </div>
    </div>

    <!-- Pending Alliance Requests -->
    <a asp-controller="PoliticalAlliance" asp-action="Index" class="block bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover-scale group relative overflow-hidden">
        @if (Model.PendingAllianceRequestsReceived > 0)
        {
            <div class="absolute top-0 right-0 -mr-4 -mt-4 w-16 h-16 bg-amber-500/10 rounded-full blur-xl group-hover:bg-amber-500/20 transition-all duration-500"></div>
            <div class="absolute top-3 right-3 flex h-3 w-3">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-amber-500"></span>
            </div>
        }
        
        <div class="flex items-start justify-between relative z-10">
            <div>
                <h3 class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">Solicitudes Recibidas</h3>
                <div class="flex items-baseline gap-2">
                    <p class="text-4xl font-black text-gray-900">@Model.PendingAllianceRequestsReceived</p>
                </div>
                <p class="text-xs text-amber-600 mt-2 font-bold group-hover:text-amber-700 flex items-center gap-1">
                    Ver solicitudes <i data-lucide="chevron-right" class="w-3 h-3"></i>
                </p>
            </div>
            <div class="p-4 bg-amber-50 text-amber-600 rounded-2xl group-hover:bg-amber-500 group-hover:text-white transition-colors duration-300">
                <i data-lucide="mail" class="w-7 h-7"></i>
            </div>
        </div>
    </a>

    <!-- Assigned Candidates to Posts -->
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-start justify-between hover-scale group cursor-default">
        <div>
            <h3 class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">Puestos Asignados</h3>
            <div class="flex items-baseline gap-2">
                <p class="text-4xl font-black text-gray-900">@Model.AssignedCandidates</p>
            </div>
            <p class="text-xs text-gray-400 mt-2 font-medium">Candidatos postulados a cargos</p>
        </div>
        <div class="p-4 bg-emerald-50 text-emerald-600 rounded-2xl group-hover:bg-emerald-600 group-hover:text-white transition-colors duration-300">
            <i data-lucide="check-circle" class="w-7 h-7"></i>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <!-- Últimos Candidatos -->
    <div class="bg-white border border-gray-100 rounded-3xl p-6 shadow-sm">
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-black text-gray-900 tracking-tight flex items-center gap-2">
                <i data-lucide="users" class="w-5 h-5 text-gray-400"></i>
                Mis Candidatos Recientes
            </h3>
            <a asp-controller="Candidate" asp-action="Index" class="text-sm font-bold text-blue-600 hover:text-blue-700">Ver todos</a>
        </div>
        @if (Model.RecentCandidates.Any())
        {
            <div class="space-y-4">
                @foreach (var candidate in Model.RecentCandidates)
                {
                    <div class="flex items-center gap-4 p-3 hover:bg-gray-50 rounded-2xl transition-colors">
                        <img src="@candidate.PhotoPath" class="w-10 h-10 rounded-full border border-gray-200 bg-white object-cover" onerror="this.src='/uploads/candidates/default.png'" />
                        <div class="flex-1">
                            <p class="text-sm font-black text-gray-900 line-clamp-1">@candidate.FullName</p>
                            <p class="text-xs font-bold text-gray-500 uppercase tracking-widest">Registrado por tu partido</p>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-8 text-gray-400">
                <i data-lucide="user-x" class="w-8 h-8 mx-auto mb-2 opacity-50"></i>
                <p class="text-sm font-medium">No hay candidatos registrados</p>
                <a asp-controller="Candidate" asp-action="Create" class="mt-3 inline-block px-4 py-2 bg-blue-50 text-blue-600 text-xs font-bold rounded-lg hover:bg-blue-100">Registrar Primero</a>
            </div>
        }
    </div>

    <!-- Partidos Aliados -->
    <div class="bg-white border border-gray-100 rounded-3xl p-6 shadow-sm">
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-black text-gray-900 tracking-tight flex items-center gap-2">
                <i data-lucide="shield-check" class="w-5 h-5 text-gray-400"></i>
                Mis Partidos Aliados
            </h3>
            <a asp-controller="PoliticalAlliance" asp-action="Index" class="text-sm font-bold text-blue-600 hover:text-blue-700">Gestionar Alianzas</a>
        </div>
        @if (Model.AlliedParties.Any())
        {
            <div class="space-y-4">
                @foreach (var allied in Model.AlliedParties)
                {
                    <div class="flex items-center gap-4 p-3 hover:bg-gray-50 rounded-2xl transition-colors">
                        <img src="@allied.LogoPath" class="w-10 h-10 rounded-full border border-gray-200 bg-white object-cover" onerror="this.src='/uploads/parties/default.png'" />
                        <div class="flex-1">
                            <p class="text-sm font-black text-gray-900 line-clamp-1">@allied.Name</p>
                            <p class="text-xs font-bold text-gray-500 uppercase tracking-widest">@allied.Acronym</p>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-8 text-gray-400">
                <i data-lucide="handshake" class="w-8 h-8 mx-auto mb-2 opacity-50"></i>
                <p class="text-sm font-medium">No cuentas con alianzas activas</p>
                <a asp-controller="PoliticalAlliance" asp-action="Create" class="mt-3 inline-block px-4 py-2 bg-blue-50 text-blue-600 text-xs font-bold rounded-lg hover:bg-blue-100">Proponer Alianza</a>
            </div>
        }
    </div>
</div>

@{
    var reportData = ViewBag.ReportData as eVote360_Pro.Application.DTOs.Voting.Responses.ResultReportResponse;
    var reportJson = reportData != null ? System.Text.Json.JsonSerializer.Serialize(reportData, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }) : "null";
}

@if (reportData != null && reportData.ResultsByPosition.Any())
{
    <div class="bg-white border border-gray-100 rounded-3xl p-8 shadow-sm">
        <div class="mb-6 flex items-center justify-between">
            <div>
                <h2 class="text-xl font-black text-gray-900 tracking-tight">Vigilancia Electoral: @reportData.ElectionName</h2>
                <p class="text-sm font-medium text-gray-500">Métricas de desempeño de tus candidatos en el primer nivel electivo.</p>
            </div>
        </div>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="relative h-[300px] w-full">
                <canvas id="leaderBarChart"></canvas>
            </div>
            <div class="relative h-[300px] w-full flex justify-center">
                <canvas id="leaderPieChart"></canvas>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const report = @Html.Raw(reportJson);
        if (report && report.resultsByPosition && report.resultsByPosition.length > 0) {
            const pos = report.resultsByPosition[0]; // Mostrar el primer puesto
            
            const labels = pos.candidates.map(c => c.candidateId === null ? "Blanco" : c.candidateName);
            const dataVotes = pos.candidates.map(c => c.votesCount);
            
            const bgColors = [
                'rgba(16, 185, 129, 0.8)', 'rgba(59, 130, 246, 0.8)', 'rgba(245, 158, 11, 0.8)',
                'rgba(239, 68, 68, 0.8)', 'rgba(139, 92, 246, 0.8)', 'rgba(107, 114, 128, 0.8)'
            ];

            new Chart(document.getElementById('leaderBarChart'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{ label: 'Votos', data: dataVotes, backgroundColor: bgColors, borderRadius: 6 }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
            });

            new Chart(document.getElementById('leaderPieChart'), {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{ data: dataVotes, backgroundColor: bgColors, borderWidth: 2 }]
                },
                options: { responsive: true, maintainAspectRatio: false, cutout: '65%', plugins: { legend: { position: 'bottom' } } }
            });
        }
    </script>
}
