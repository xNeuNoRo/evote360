@model eVote360_Pro.Application.Interfaces.Services.DashboardStatisticsResponse
@{
    ViewData["Title"] = "Panel de Control Administrador";
    ViewData["Breadcrumbs"] = new List<(string, string?, string?)>
    {
        ("Inicio", null, null),
        ("Panel Administrador", null, null)
    };
}

<div class="mb-8">
    <h1 class="text-3xl font-black text-gray-900 tracking-tight flex items-center gap-2">
        <i data-lucide="layout-dashboard" class="w-8 h-8 text-blue-600"></i>
        Resumen del Sistema
    </h1>
    <p class="text-sm text-gray-500 mt-2 font-medium">Estadísticas generales de la plataforma eVote360 Pro.</p>
</div>

<!-- Active Election Status Banner -->
@if (!string.IsNullOrEmpty(Model.ActiveElectionName))
{
    <div class="mb-8 bg-blue-600 rounded-2xl p-6 text-white shadow-lg shadow-blue-200 relative overflow-hidden group">
        <div class="absolute top-0 right-0 -mr-8 -mt-8 w-48 h-48 bg-white opacity-10 rounded-full blur-2xl group-hover:scale-110 transition-transform duration-700"></div>
        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black bg-white/20 text-white uppercase tracking-wider mb-3">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse pulse-node"></span>
                    Elección Activa
                </span>
                <h2 class="text-2xl font-black tracking-tight">@Model.ActiveElectionName</h2>
                <p class="text-blue-100 mt-1 text-sm font-medium">El proceso de votación está abierto actualmente.</p>
            </div>
            <div class="flex items-center gap-4 bg-black/20 px-6 py-4 rounded-xl backdrop-blur-sm border border-white/10">
                <div class="p-3 bg-white/10 rounded-lg text-emerald-400">
                    <i data-lucide="users" class="w-6 h-6"></i>
                </div>
                <div>
                    <div class="text-xs text-blue-100 uppercase tracking-wider font-bold mb-0.5">Votos Emitidos</div>
                    <div class="text-3xl font-black tracking-tight">@Model.VoterParticipationCount.ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- Total Citizens -->
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-start gap-4 hover-scale">
        <div class="p-3 bg-indigo-50 text-indigo-600 rounded-xl">
            <i data-lucide="users-2" class="w-6 h-6"></i>
        </div>
        <div>
            <h3 class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-1">Padrón Electoral</h3>
            <p class="text-3xl font-black text-gray-900">@Model.TotalCitizens.ToString("N0")</p>
            <p class="text-xs text-gray-400 mt-1">Ciudadanos registrados</p>
        </div>
    </div>

    <!-- Total Parties -->
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-start gap-4 hover-scale">
        <div class="p-3 bg-blue-50 text-blue-600 rounded-xl">
            <i data-lucide="flag" class="w-6 h-6"></i>
        </div>
        <div>
            <h3 class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-1">Partidos Políticos</h3>
            <p class="text-3xl font-black text-gray-900">@Model.TotalParties.ToString("N0")</p>
            <p class="text-xs text-gray-400 mt-1">Organizaciones registradas</p>
        </div>
    </div>

    <!-- Total Elections -->
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-start gap-4 hover-scale">
        <div class="p-3 bg-purple-50 text-purple-600 rounded-xl">
            <i data-lucide="archive" class="w-6 h-6"></i>
        </div>
        <div>
            <h3 class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-1">Elecciones Históricas</h3>
            <p class="text-3xl font-black text-gray-900">@Model.TotalElections.ToString("N0")</p>
            <p class="text-xs text-gray-400 mt-1">Procesos en el sistema</p>
        </div>
    </div>
</div>
