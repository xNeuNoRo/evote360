@{
    Layout = "_VoterLayout";
    ViewData["Title"] = "Sin Elecciones Activas";
}

<div class="flex flex-col items-center justify-center py-20 text-center max-w-lg mx-auto">
    <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mb-6">
        <i data-lucide="calendar-off" class="w-12 h-12 text-gray-400"></i>
    </div>
    
    <h1 class="text-3xl font-black text-gray-900 tracking-tight mb-4">No hay elecciones en curso</h1>
    
    <p class="text-gray-500 font-medium leading-relaxed">
        @ViewBag.ErrorMessage 
        El padrón electoral y las cabinas de votación permanecerán cerradas hasta que el Administrador active un nuevo proceso electoral oficial.
    </p>

    <a href="/" class="mt-8 inline-flex items-center gap-2 bg-gray-900 hover:bg-gray-800 text-white px-6 py-3 rounded-xl font-bold transition-all shadow-lg hover:-translate-y-0.5 active:scale-95 cursor-pointer">
        <i data-lucide="home" class="w-4 h-4"></i>
        Volver al Inicio
    </a>
</div>
