@model string
@{
    Layout = "_VoterLayout";
    ViewData["Title"] = "Autenticación Electoral";
}

<div class="max-w-xl mx-auto">
    <div class="text-center mb-10">
        <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">Autenticación Electoral</h1>
        <p class="text-gray-500 font-medium">Por favor, ingresa tu número de documento de identidad para validar tu participación en el proceso electoral activo.</p>
    </div>

    <form asp-action="Index" method="post" class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8 space-y-6 relative overflow-hidden">
        
        <div class="absolute top-0 right-0 -mr-8 -mt-8 w-32 h-32 bg-blue-50 rounded-full blur-2xl"></div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="bg-red-50 text-red-600 p-4 rounded-xl text-sm font-bold flex items-start gap-3 relative z-10">
                <i data-lucide="alert-circle" class="w-5 h-5 shrink-0 mt-0.5"></i>
                <div>
                    <div asp-validation-summary="All" class="mt-1"></div>
                </div>
            </div>
        }

        <!-- Cédula -->
        <div class="relative z-10">
            <label for="identityDocument" class="block text-xs font-black text-gray-400 uppercase tracking-wider mb-2">Número de documento de identidad</label>
            <input type="text" id="identityDocument" name="identityDocument" value="@Model" class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-2xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:bg-white transition-all text-lg font-black text-gray-900 tracking-widest placeholder:tracking-normal placeholder:font-medium placeholder:text-gray-400" placeholder="000-0000000-0" required />
        </div>

        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white px-6 py-4 rounded-2xl font-black text-lg transition-all shadow-xl shadow-blue-200 hover:shadow-blue-300 hover:-translate-y-0.5 active:scale-95 cursor-pointer flex items-center justify-center gap-2 group mt-8 relative z-10">
            Votar
            <i data-lucide="arrow-right" class="w-5 h-5 group-hover:translate-x-1 transition-transform"></i>
        </button>

        <div class="pt-6 border-t border-gray-100 text-center relative z-10">
            <p class="text-sm text-gray-500 font-medium mb-3">¿Eres administrador o miembro de un partido?</p>
            <a asp-controller="Auth" asp-action="Index" class="inline-flex items-center gap-2 text-sm font-bold text-gray-900 hover:text-blue-600 transition-colors">
                <i data-lucide="shield" class="w-4 h-4"></i>
                Acceder al sistema
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://unpkg.com/imask"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var idInput = document.getElementById('identityDocument');
            if (idInput) {
                IMask(idInput, { mask: '000-0000000-0' });
            }
        });
    </script>
}
