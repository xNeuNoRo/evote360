@using eVote360_Pro.Application.ViewModels.CandidateViewModels
@model CreateCandidateViewModel

<div class="max-w-2xl mx-auto">
    <div class="mb-8">
        <h1 class="text-3xl font-black text-gray-900 tracking-tight">Registrar Candidato</h1>
        <p class="text-gray-500 text-sm mt-1 font-medium">Añade un nuevo candidato que representará a tu partido.</p>
    </div>

    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8">
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-6">
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label asp-for="FirstName" class="block text-xs font-black text-gray-400 uppercase tracking-wider mb-2">Nombre</label>
                    <input asp-for="FirstName" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:bg-white transition-all text-sm font-medium text-gray-900" placeholder="Ej. Juan" />
                    <span asp-validation-for="FirstName" class="text-xs font-bold text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="LastName" class="block text-xs font-black text-gray-400 uppercase tracking-wider mb-2">Apellido</label>
                    <input asp-for="LastName" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:bg-white transition-all text-sm font-medium text-gray-900" placeholder="Ej. Pérez" />
                    <span asp-validation-for="LastName" class="text-xs font-bold text-red-500 mt-1 block"></span>
                </div>
            </div>

            <div>
                <label asp-for="PhotoFile" class="block text-xs font-black text-gray-400 uppercase tracking-wider mb-2">Fotografía del Candidato</label>
                <div class="relative group">
                    <input asp-for="PhotoFile" type="file" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" id="photo-upload" />
                    <div id="upload-zone" class="w-full px-4 py-8 bg-gray-50 border-2 border-dashed border-gray-200 rounded-2xl text-center group-hover:bg-blue-50 group-hover:border-blue-300 transition-all flex flex-col items-center justify-center min-h-[200px]">
                        <img id="photo-preview" class="w-32 h-32 object-cover rounded-xl shadow-md hidden mb-4 border-2 border-white" alt="Vista previa" />
                        <i data-lucide="image-plus" id="upload-icon" class="w-8 h-8 mx-auto text-gray-400 group-hover:text-blue-500 transition-colors mb-2"></i>
                        <p class="text-sm font-bold text-gray-600" id="upload-text">Haz clic o arrastra la foto aquí</p>
                        <p class="text-xs font-medium text-gray-400 mt-1" id="upload-hint">PNG, JPG hasta 5MB. Relación recomendada 1:1.</p>
                    </div>
                </div>
                <span asp-validation-for="PhotoFile" class="text-xs font-bold text-red-500 mt-1 block"></span>
            </div>

            <div class="pt-6 border-t border-gray-100 flex items-center justify-end gap-3">
                <a asp-action="Index" class="px-5 py-2.5 text-sm font-bold text-gray-600 hover:bg-gray-100 rounded-xl transition-colors cursor-pointer">
                    Cancelar
                </a>
                <button type="submit" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-xl font-bold transition-all shadow-lg shadow-blue-200 hover:shadow-blue-300 hover:-translate-y-0.5 active:scale-95 active:translate-y-0 cursor-pointer">
                    <i data-lucide="save" class="w-4 h-4"></i>
                    Guardar Candidato
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const uploadInput = document.getElementById('photo-upload');
        const photoPreview = document.getElementById('photo-preview');
        const uploadIcon = document.getElementById('upload-icon');
        const uploadText = document.getElementById('upload-text');
        const uploadHint = document.getElementById('upload-hint');

        uploadInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                // Previsualizar la imagen
                const reader = new FileReader();
                reader.onload = function(e) {
                    photoPreview.src = e.target.result;
                    photoPreview.classList.remove('hidden');
                    uploadIcon.classList.add('hidden');
                    uploadHint.classList.add('hidden');
                    uploadText.innerHTML = `<span class="text-blue-600">Cambiar fotografía</span>`;
                }
                reader.readAsDataURL(file);
            } else {
                // Restaurar el estado original si el usuario cancela la selección
                photoPreview.src = '';
                photoPreview.classList.add('hidden');
                uploadIcon.classList.remove('hidden');
                uploadHint.classList.remove('hidden');
                uploadText.innerHTML = `Haz clic o arrastra la foto aquí`;
            }
        });
    </script>
}
