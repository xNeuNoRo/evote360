@using eVote360_Pro.Application.ViewModels.CandidateViewModels
@model UpdateCandidateViewModel

<div class="max-w-2xl mx-auto">
    <div class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h1 class="text-3xl font-black text-gray-900 tracking-tight">Editar Candidato</h1>
            <p class="text-gray-500 text-sm mt-1 font-medium">Modifica la información o el estado del candidato.</p>
        </div>
        @if (Model.HasParticipated)
        {
            <div class="inline-flex items-center gap-2 bg-amber-50 text-amber-700 px-4 py-2 rounded-xl border border-amber-200 shadow-sm">
                <i data-lucide="lock" class="w-4 h-4"></i>
                <span class="text-xs font-black uppercase tracking-wider">Perfil Bloqueado</span>
            </div>
        }
    </div>

    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8">
        
        @if (Model.HasParticipated)
        {
            <div class="mb-6 p-4 bg-blue-50/50 border border-blue-100 rounded-2xl flex gap-3">
                <i data-lucide="info" class="w-5 h-5 text-blue-500 shrink-0 mt-0.5"></i>
                <p class="text-sm font-medium text-blue-800">
                    Este candidato ya ha participado en una elección (activa o finalizada). Por motivos de integridad histórica, <strong>su nombre, apellido y foto no pueden ser modificados</strong>. Solo puedes cambiar su estado.
                </p>
            </div>
        }

        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="space-y-6">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="HasParticipated" />
            <input type="hidden" asp-for="CurrentPhotoPath" />
            
            @if (Model.HasParticipated)
            {
                <input type="hidden" asp-for="FirstName" />
                <input type="hidden" asp-for="LastName" />
            }

            <div class="flex items-center gap-6 mb-8">
                <div class="w-24 h-24 rounded-2xl border-4 border-white shadow-lg overflow-hidden shrink-0">
                    <img src="@Model.CurrentPhotoPath" alt="Foto Actual" class="w-full h-full object-cover" />
                </div>
                <div>
                    <h3 class="text-lg font-black text-gray-900 tracking-tight">@Model.FirstName @Model.LastName</h3>
                    <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mt-1">Candidato Actual</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label asp-for="FirstName" class="block text-xs font-black text-gray-400 uppercase tracking-wider mb-2">Nombre</label>
                    <input asp-for="FirstName" disabled="@(Model.HasParticipated ? "disabled" : null)" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:bg-white transition-all text-sm font-medium text-gray-900 disabled:opacity-60 disabled:bg-gray-100" />
                    <span asp-validation-for="FirstName" class="text-xs font-bold text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="LastName" class="block text-xs font-black text-gray-400 uppercase tracking-wider mb-2">Apellido</label>
                    <input asp-for="LastName" disabled="@(Model.HasParticipated ? "disabled" : null)" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:bg-white transition-all text-sm font-medium text-gray-900 disabled:opacity-60 disabled:bg-gray-100" />
                    <span asp-validation-for="LastName" class="text-xs font-bold text-red-500 mt-1 block"></span>
                </div>
            </div>

            @if (!Model.HasParticipated)
            {
                <div>
                    <label asp-for="PhotoFile" class="block text-xs font-black text-gray-400 uppercase tracking-wider mb-2">Actualizar Fotografía (Opcional)</label>
                    <div class="relative group">
                        <input asp-for="PhotoFile" type="file" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" id="photo-upload" />
                        <div class="w-full px-4 py-6 bg-gray-50 border-2 border-dashed border-gray-200 rounded-2xl text-center group-hover:bg-blue-50 group-hover:border-blue-300 transition-all flex flex-col items-center justify-center min-h-[140px]">
                            <img id="photo-preview" class="w-20 h-20 object-cover rounded-xl shadow-md hidden mb-3 border-2 border-white" alt="Vista previa" />
                            <i data-lucide="image-plus" id="upload-icon" class="w-6 h-6 mx-auto text-gray-400 group-hover:text-blue-500 transition-colors mb-2"></i>
                            <p class="text-sm font-bold text-gray-600" id="upload-text">Reemplazar foto actual</p>
                        </div>
                    </div>
                    <span asp-validation-for="PhotoFile" class="text-xs font-bold text-red-500 mt-1 block"></span>
                </div>
            }

            <div class="flex items-center gap-3 p-4 bg-gray-50 rounded-2xl border border-gray-100">
                <div class="flex items-center h-5">
                    <input asp-for="IsActive" class="w-5 h-5 text-blue-600 bg-white border-gray-300 rounded focus:ring-blue-500 focus:ring-2 cursor-pointer" />
                </div>
                <div class="ml-2">
                    <label asp-for="IsActive" class="text-sm font-black text-gray-900 tracking-tight cursor-pointer">Candidato Activo</label>
                    <p class="text-xs font-medium text-gray-500 mt-0.5">Determina si el candidato puede ser asignado a boletas o participar en elecciones.</p>
                </div>
            </div>

            <div class="pt-6 border-t border-gray-100 flex items-center justify-end gap-3">
                <a asp-action="Index" class="px-5 py-2.5 text-sm font-bold text-gray-600 hover:bg-gray-100 rounded-xl transition-colors cursor-pointer">
                    Cancelar
                </a>
                <button type="submit" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-xl font-bold transition-all shadow-lg shadow-blue-200 hover:shadow-blue-300 hover:-translate-y-0.5 active:scale-95 active:translate-y-0 cursor-pointer">
                    <i data-lucide="save" class="w-4 h-4"></i>
                    Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const uploadInput = document.getElementById('photo-upload');
        if (uploadInput) {
            const photoPreview = document.getElementById('photo-preview');
            const uploadIcon = document.getElementById('upload-icon');
            const uploadText = document.getElementById('upload-text');

            uploadInput.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        photoPreview.src = e.target.result;
                        photoPreview.classList.remove('hidden');
                        uploadIcon.classList.add('hidden');
                        uploadText.innerHTML = `<span class="text-blue-600">Cambiar fotografía</span>`;
                    }
                    reader.readAsDataURL(file);
                } else {
                    photoPreview.src = '';
                    photoPreview.classList.add('hidden');
                    uploadIcon.classList.remove('hidden');
                    uploadText.innerHTML = `Reemplazar foto actual`;
                }
            });
        }
    </script>
}
