@model eVote360_Pro.Application.Models.Emails.OtpVerificationModel

<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: 'Plus Jakarta Sans', -apple-system, sans-serif; background-color: #F1F5F9; padding: 20px; color: #334155; margin: 0; }
        .inner { background: #ffffff; max-width: 500px; margin: 0 auto; border-radius: 24px; overflow: hidden; box-shadow: 0 30px 60px -12px rgba(0, 0, 100, 0.1); border: 1px solid rgba(0,0,0,0.05); }
        .branding { padding: 30px 40px 10px; font-weight: 800; font-size: 20px; color: #002D62; }
        .branding span { color: #CE1126; }
        .header { padding: 45px 40px; background: linear-gradient(135deg, #002D62 0%, #004A8F 100%); color: #ffffff; position: relative; }
        .dr-flag { position: absolute; bottom: 0; left: 0; width: 100%; height: 6px; display: flex; }
        .flag-blue { flex: 1; background: #002D62; } .flag-red { flex: 1; background: #CE1126; } .flag-white { width: 10px; background: #ffffff; }
        .h-title { font-size: 26px; font-weight: 800; margin: 0; line-height: 1.2; }
        .h-subtitle { font-size: 13px; font-weight: 600; opacity: 0.9; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 1.5px; display: block; }
        .content { padding: 45px 40px; }
        .greeting { font-size: 18px; font-weight: 700; color: #002D62; margin-bottom: 18px; }
        .code-display { background: #EFF6FF; border: 2px solid #DBEAFE; border-radius: 20px; padding: 35px; text-align: center; margin: 30px 0; }
        .code-number { font-family: 'Courier New', monospace; font-size: 44px; font-weight: 800; color: #002D62; letter-spacing: 12px; margin-left: 12px; }
        .security-banner { background: #FEF2F2; border-radius: 12px; padding: 16px; margin-top: 30px; border: 1px solid #FEE2E2; text-align: center; font-size: 13px; color: #CE1126; font-weight: 600; }
        .footer { padding: 35px 40px; background: #F8FAFC; text-align: center; border-top: 1px solid #F1F5F9; font-size: 12px; color: #94A3B8; line-height: 1.6; }
    </style>
</head>
<body>
    <div class="inner">
        <div class="branding">eVote360<span>.</span>Pro</div>
        <div class="header">
            <span class="h-subtitle">Acceso al Centro de Votación</span>
            <div class="h-title">Confirma que eres tú</div>
            <div class="dr-flag"><div class="flag-blue"></div><div class="flag-white"></div><div class="flag-red"></div></div>
        </div>
        <div class="content">
            <div class="greeting">Hola, @Model.FullName</div>
            <p style="font-size: 15px; line-height: 1.8; color: #475569;">Para proteger la integridad de tu voto y garantizar un proceso democrático transparente, hemos generado un código de acceso temporal para tu sesión.</p>
            
            <div class="code-display">
                <div style="font-size: 11px; font-weight: 800; color: #94A3B8; text-transform: uppercase; margin-bottom: 12px; letter-spacing: 0.5px;">Tu código de seguridad</div>
                <div class="code-number">@Model.Code</div>
            </div>

            <div class="security-banner">
                ⏳ Este código vence en 5 minutos. El voto es un derecho sagrado, personal y secreto.
            </div>
        </div>
        <div class="footer">
            Enviado bajo los protocolos de la Junta Central Electoral Digital.<br>
            &copy; 2026 eVote360 Pro &bull; República Dominicana
        </div>
    </div>
</body>
</html>
