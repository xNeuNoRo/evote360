@model eVote360_Pro.Application.Models.Emails.UserWelcomeModel

<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: 'Plus Jakarta Sans', -apple-system, sans-serif; background-color: #F1F5F9; padding: 20px; color: #334155; margin: 0; }
        .inner { background: #ffffff; max-width: 500px; margin: 0 auto; border-radius: 24px; overflow: hidden; box-shadow: 0 30px 60px -12px rgba(0, 0, 100, 0.1); border: 1px solid rgba(0,0,0,0.05); }
        .branding { padding: 30px 40px 10px; font-weight: 800; font-size: 20px; color: #002D62; }
        .branding span { color: #CE1126; }
        .header { padding: 45px 40px; background: linear-gradient(135deg, #064e3b 0%, #065f46 100%); color: #ffffff; position: relative; }
        .dr-flag { position: absolute; bottom: 0; left: 0; width: 100%; height: 6px; display: flex; }
        .flag-blue { flex: 1; background: #002D62; } .flag-red { flex: 1; background: #CE1126; } .flag-white { width: 10px; background: #ffffff; }
        .h-title { font-size: 26px; font-weight: 800; margin: 0; line-height: 1.2; }
        .h-subtitle { font-size: 13px; font-weight: 600; opacity: 0.9; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 1.5px; display: block; }
        .content { padding: 45px 40px; }
        .greeting { font-size: 18px; font-weight: 700; color: #002D62; margin-bottom: 18px; }
        .data-card { border: 1px solid #E2E8F0; border-radius: 16px; padding: 24px; background: #fff; margin-bottom: 30px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02); }
        .data-row { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #F1F5F9; }
        .data-row:last-child { border: none; }
        .data-label { font-size: 11px; font-weight: 800; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.5px; }
        .data-value { font-size: 14px; font-weight: 700; color: #002D62; }
        .action-button { display: inline-block; padding: 18px 36px; border-radius: 14px; font-weight: 700; text-decoration: none; font-size: 15px; background-color: #002D62; color: white !important; box-shadow: 0 10px 15px -3px rgba(0, 45, 98, 0.3); }
        .footer { padding: 35px 40px; background: #F8FAFC; text-align: center; border-top: 1px solid #F1F5F9; font-size: 12px; color: #94A3B8; line-height: 1.6; }
    </style>
</head>
<body>
    <div class="inner">
        <div class="branding">eVote360<span>.</span>Pro</div>
        <div class="header">
            <span class="h-subtitle">Portal de Gestión Electoral</span>
            <div class="h-title">¡Bienvenido al equipo!</div>
            <div class="dr-flag"><div class="flag-blue"></div><div class="flag-white"></div><div class="flag-red"></div></div>
        </div>
        <div class="content">
            <div class="greeting">Estimado(a) @Model.FullName,</div>
            <p style="font-size: 15px; line-height: 1.8; color: #475569; margin-bottom: 25px;">Tu cuenta administrativa ha sido habilitada con éxito. A partir de este momento, eres parte esencial en la construcción de la democracia digital dominicana.</p>
            
            <div class="data-card">
                <div class="data-row">
                    <span class="data-label">Nombre de Usuario</span>
                    <span class="data-value">@Model.Username</span>
                </div>
                <div class="data-row">
                    <span class="data-label">Clave Provisional</span>
                    <span class="data-value" style="font-family: monospace; background: #F1F5F9; padding: 4px 10px; border-radius: 6px; color: #CE1126;">@Model.TemporaryPassword</span>
                </div>
            </div>

            <div style="text-align: center;">
                <a href="@Model.LoginUrl" class="action-button">Entrar al Portal</a>
            </div>

            <p style="font-size: 13px; color: #64748b; text-align: center; margin-top: 25px;">Por seguridad, deberás cambiar esta clave al ingresar por primera vez.</p>
        </div>
        <div class="footer">
            Si no solicitaste este acceso, favor informar a la mesa de ayuda técnica.<br>
            &copy; 2026 eVote360 Pro &bull; República Dominicana
        </div>
    </div>
</body>
</html>
