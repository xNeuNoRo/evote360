@model eVote360_Pro.Application.Models.Emails.VoteConfirmationModel

<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: 'Plus Jakarta Sans', -apple-system, sans-serif; background-color: #F1F5F9; padding: 20px; color: #334155; margin: 0; }
        .inner { background: #ffffff; max-width: 500px; margin: 0 auto; border-radius: 24px; overflow: hidden; box-shadow: 0 30px 60px -12px rgba(0, 0, 100, 0.1); border: 1px solid rgba(0,0,0,0.05); }
        .branding { padding: 30px 40px 10px; font-weight: 800; font-size: 20px; color: #002D62; }
        .branding span { color: #CE1126; }
        .header { padding: 45px 40px; background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff; position: relative; }
        .dr-flag { position: absolute; bottom: 0; left: 0; width: 100%; height: 6px; display: flex; }
        .flag-blue { flex: 1; background: #002D62; } .flag-red { flex: 1; background: #CE1126; } .flag-white { width: 10px; background: #ffffff; }
        .h-title { font-size: 26px; font-weight: 800; margin: 0; line-height: 1.2; }
        .h-subtitle { font-size: 13px; font-weight: 600; opacity: 0.9; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 1.5px; display: block; }
        .content { padding: 45px 40px; }
        .greeting { font-size: 18px; font-weight: 700; color: #002D62; margin-bottom: 18px; }
        .receipt-card { background: #0F172A; border-radius: 20px; padding: 35px; color: #f8fafc; margin: 20px 0; }
        .data-row { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #334155; font-size: 14px; }
        .data-row:last-child { border: none; }
        .data-label { color: #94A3B8; font-weight: 600; text-transform: uppercase; font-size: 11px; }
        .id-badge { display: block; text-align: center; margin-top: 15px; font-family: monospace; font-size: 22px; font-weight: 800; color: #FDE68A; letter-spacing: 2px; }
        .footer { padding: 35px 40px; background: #F8FAFC; text-align: center; border-top: 1px solid #F1F5F9; font-size: 12px; color: #94A3B8; line-height: 1.6; }
    </style>
</head>
<body>
    <div class="inner">
        <div class="branding">eVote360<span>.</span>Pro</div>
        <div class="header">
            <span class="h-subtitle">Certificado de Participación</span>
            <div class="h-title">Tu voto ha sido registrado</div>
            <div class="dr-flag"><div class="flag-blue"></div><div class="flag-white"></div><div class="flag-red"></div></div>
        </div>
        <div class="content">
            <div class="greeting">¡Misión cumplida, @Model.CitizenName!</div>
            <p style="font-size: 15px; line-height: 1.8; color: #475569;">Tu participación en estas elecciones ha sido grabada de forma segura y totalmente anónima. Gracias por fortalecer nuestra nación.</p>
            
            <div class="receipt-card">
                <div style="text-align: center; border-bottom: 1px solid #334155; padding-bottom: 15px; margin-bottom: 15px;">
                    <span style="background: #fff7ed; color: #9a3412; border: 1px solid #ffedd5; padding: 4px 12px; border-radius: 8px; font-size: 11px; font-weight: 800;">RECIBO OFICIAL</span>
                </div>
                <div class="data-row">
                    <span class="data-label">Elección</span>
                    <span style="font-weight: 600;">@Model.ElectionName</span>
                </div>
                <div class="data-row">
                    <span class="data-label">Fecha y Hora</span>
                    <span>@Model.Date</span>
                </div>
                <div style="margin-top: 25px; text-align: center; background: rgba(255,255,255,0.05); padding: 20px; border-radius: 12px;">
                    <span class="data-label">Código Único de Registro</span>
                    <span class="id-badge"># @Model.ParticipationCode</span>
                </div>
            </div>
            
            <p style="font-size: 11px; color: #64748b; text-align: center; margin-top: 25px; line-height: 1.5;">
                * Este documento es un comprobante de que ejerciste tu derecho. El sistema nunca guarda por quién votaste; tu elección es anónima e irreversible.
            </p>
        </div>
        <div class="footer">
            Junta Central Electoral &bull; República Dominicana
        </div>
    </div>
</body>
</html>
