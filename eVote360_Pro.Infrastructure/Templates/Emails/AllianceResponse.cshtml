@model eVote360_Pro.Application.Models.Emails.AllianceResponseModel

<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: 'Plus Jakarta Sans', -apple-system, sans-serif; background-color: #F1F5F9; padding: 20px; color: #334155; margin: 0; }
        .inner { background: #ffffff; max-width: 500px; margin: 0 auto; border-radius: 24px; overflow: hidden; box-shadow: 0 30px 60px -12px rgba(0, 0, 100, 0.1); border: 1px solid rgba(0,0,0,0.05); }
        .branding { padding: 30px 40px 10px; font-weight: 800; font-size: 20px; color: #002D62; }
        .branding span { color: #CE1126; }
        .header { padding: 45px 40px; background: linear-gradient(135deg, #334155 0%, #1e293b 100%); color: #ffffff; position: relative; }
        .dr-flag { position: absolute; bottom: 0; left: 0; width: 100%; height: 6px; display: flex; }
        .flag-blue { flex: 1; background: #002D62; } .flag-red { flex: 1; background: #CE1126; } .flag-white { width: 10px; background: #ffffff; }
        .h-title { font-size: 26px; font-weight: 800; margin: 0; line-height: 1.2; }
        .h-subtitle { font-size: 13px; font-weight: 600; opacity: 0.8; margin-bottom: 5px; text-transform: uppercase; letter-spacing: 1.5px; display: block; }
        .content { padding: 45px 40px; text-align: center; }
        .status-badge { display: inline-block; padding: 10px 24px; border-radius: 12px; font-size: 13px; font-weight: 800; color: white; margin-bottom: 25px; text-transform: uppercase; }
        .accepted { background-color: #059669; box-shadow: 0 4px 10px rgba(5, 150, 105, 0.2); }
        .rejected { background-color: #dc2626; box-shadow: 0 4px 10px rgba(220, 38, 38, 0.2); }
        .message-box { background: #f8fafc; padding: 25px; border-radius: 16px; margin-top: 10px; border: 1px solid #e2e8f0; }
        .footer { padding: 35px 40px; background: #F8FAFC; text-align: center; border-top: 1px solid #F1F5F9; font-size: 12px; color: #94A3B8; line-height: 1.6; }
    </style>
</head>
<body>
    <div class="inner">
        <div class="branding">eVote360<span>.</span>Pro</div>
        <div class="header">
            <span class="h-subtitle">Actualización de Pacto</span>
            <div class="h-title">Respuesta a Solicitud</div>
            <div class="dr-flag"><div class="flag-blue"></div><div class="flag-white"></div><div class="flag-red"></div></div>
        </div>
        <div class="content">
            <div class="status-badge @(Model.Status == "ACEPTADA" ? "accepted" : "rejected")">
                PACTO @Model.Status
            </div>
            <p style="font-size: 15px; line-height: 1.7; color: #475569;">Se ha procesado tu solicitud de alianza enviada al partido <strong>@Model.ReceiverPartyName</strong>.</p>
            <div class="message-box">
                <p style="font-style: italic; font-size: 14px; margin: 0; color: #1e293b; font-weight: 500;">"@Model.Message"</p>
            </div>
        </div>
        <div class="footer">
            &copy; 2026 eVote360 Pro &bull; Gestión de Transparencia
        </div>
    </div>
</body>
</html>


