@model eVote360_Pro.Application.Models.Emails.AllianceRequestModel

<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: 'Plus Jakarta Sans', -apple-system, sans-serif; background-color: #F1F5F9; padding: 20px; color: #334155; margin: 0; }
        .inner { background: #ffffff; max-width: 500px; margin: 0 auto; border-radius: 24px; overflow: hidden; box-shadow: 0 30px 60px -12px rgba(0, 0, 100, 0.1); border: 1px solid rgba(0,0,0,0.05); }
        .branding { padding: 30px 40px 10px; font-weight: 800; font-size: 20px; color: #002D62; }
        .branding span { color: #CE1126; }
        .header { padding: 45px 40px; background: linear-gradient(135deg, #4c1d95 0%, #5b21b6 100%); color: #ffffff; position: relative; }
        .dr-flag { position: absolute; bottom: 0; left: 0; width: 100%; height: 6px; display: flex; }
        .flag-blue { flex: 1; background: #002D62; } .flag-red { flex: 1; background: #CE1126; } .flag-white { width: 10px; background: #ffffff; }
        .h-title { font-size: 26px; font-weight: 800; margin: 0; line-height: 1.2; }
        .h-subtitle { font-size: 13px; font-weight: 600; opacity: 0.9; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 1.5px; display: block; }
        .content { padding: 45px 40px; }
        .greeting { font-size: 18px; font-weight: 700; color: #002D62; margin-bottom: 18px; }
        .proposal-box { background: #fdf4ff; border: 1px solid #f5d0fe; padding: 25px; border-radius: 16px; margin-bottom: 30px; }
        .action-button { display: inline-block; padding: 18px 36px; border-radius: 14px; font-weight: 700; text-decoration: none; font-size: 15px; background-color: #7c3aed; color: white !important; box-shadow: 0 10px 15px -3px rgba(124, 58, 237, 0.3); }
        .footer { padding: 35px 40px; background: #F8FAFC; text-align: center; border-top: 1px solid #F1F5F9; font-size: 12px; color: #94A3B8; line-height: 1.6; }
    </style>
</head>
<body>
    <div class="inner">
        <div class="branding">eVote360<span>.</span>Pro</div>
        <div class="header">
            <span class="h-subtitle">Pactos y Alianzas</span>
            <div class="h-title">Propuesta de Acuerdo</div>
            <div class="dr-flag"><div class="flag-blue"></div><div class="flag-white"></div><div class="flag-red"></div></div>
        </div>
        <div class="content">
            <div class="greeting">Estimado(a) @Model.ReceiverLeaderName,</div>
            <p style="font-size: 15px; line-height: 1.8; color: #475569;">El <strong>@Model.RequesterPartyName</strong> ha enviado una solicitud formal para establecer un pacto de alianza estratégica con su partido político.</p>
            
            <div class="proposal-box">
                <p style="margin: 0; font-size: 14px; color: #701a75; font-weight: 600; line-height: 1.6;">Esta solicitud está pendiente de su revisión. Al aceptar, ambos partidos podrán presentar candidaturas conjuntas en la boleta oficial.</p>
            </div>

            <div style="text-align: center;">
                <a href="@Model.ActionUrl" class="action-button">Ver Detalles del Pacto</a>
            </div>
        </div>
        <div class="footer">
            Módulo de Coordinación Partidaria &bull; eVote360 Pro<br>
            República Dominicana
        </div>
    </div>
</body>
</html>
